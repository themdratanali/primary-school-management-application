# Security Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Permitted-Cross-Domain-Policies "none"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://code.jquery.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: http: https:; connect-src 'self';"
</IfModule>

DirectoryIndex public/index.php

Options -Indexes
RewriteEngine On
RewriteBase /apex/

# Block direct access to internal folders
RewriteRule ^env/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Block direct HTTP requests to legacy paths (internal rewrites still work)
RewriteCond %{THE_REQUEST} \s/apex/app/ [NC]
RewriteRule ^app/ - [F,L]

# Static assets
RewriteRule ^(library|uploads)/ - [L]

# Legacy pretty URLs -> new route prefixes
RewriteRule ^admin/login/?$ author/a/admin/login [R=301,L]
RewriteRule ^admin/dashboard/?$ author/a/admin/dashboard [R=301,L]
RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ author/a/admin/$1 [R=301,L]

# Admin portal
RewriteRule ^author/a/admin/?$ author/a/admin/dashboard/overview [R=301,L]
RewriteRule ^author/a/admin/dashboard/?$ author/a/admin/dashboard/overview [R=301,L]
RewriteRule ^author/a/admin/login/?$ app/admin/login.php [L,QSA]
RewriteRule ^author/a/admin/dashboard/([a-zA-Z0-9_-]+)/?$ app/admin/dashboard.php?section=$1 [L,QSA]
RewriteRule ^author/a/admin/dashboard/page/([a-zA-Z0-9_-]+)/?$ app/admin/$1.php [L,QSA]
RewriteRule ^author/a/admin/([a-zA-Z0-9_-]+)/?$ app/admin/$1.php [L,QSA]


# Student portal: /public/s/student/{page} (with friendly aliases)
RewriteRule ^public/s/student/?$ public/s/student/dashboard [R=301,L]
RewriteRule ^public/s/student/login/?$ app/student/login.php [L,QSA]
RewriteRule ^public/s/student/dashboard/?$ app/student/dashboard.php [L,QSA]
RewriteRule ^public/s/student/results/?$ app/student/student_results.php [L,QSA]
RewriteRule ^public/s/student/fees/?$ app/student/student_fees.php [L,QSA]
RewriteRule ^public/s/student/logout/?$ app/student/student_logout.php [L,QSA]
RewriteRule ^public/s/student/([a-zA-Z0-9_-]+)/?$ app/student/$1.php [L,QSA]

# Public website pages (no .php extension)
RewriteRule ^$ public/index.php [L]
RewriteRule ^(admission|contact|teachers|routine|syllabus|results|holidays|staff|seats|classrooms|vacancies|download)/?$ public/$1.php [L,QSA]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|ini|conf|sql|bak|old|zip|tar|gz)$">
    Require all denied
</FilesMatch>

ServerSignature Off
